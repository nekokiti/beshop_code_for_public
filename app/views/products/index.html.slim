h1
  span =t('activerecord.models.product')
.field.form-group
  = link_to '新規商品登録', new_product_path, class: ['btn', 'btn-primary']
  - if OccupationMst.is_reserve?(company: current_company)
    = link_to 'csvエクスポート', csv_export_products_path(page: params[:page]), class: ['btn', 'btn-primary', 'ml-1'], target:'_blank'


- if OccupationMst.is_reserve?(company: current_company)
  h2 CSVで商品を登録
  = form_with url: csv_import_products_path do |f|
    .field.form-group
      = f.file_field :file, accept: '.csv'
    .field.form-group
      = f.submit "CSVアップロード", class: ['btn', 'btn-primary']
      - if @errors.present?
        - @errors.each do |error|
        - error[:messages].each do |message|
          li = "#{error[:row_num]}行目：#{message}"

.table-responsive
  table.table.table-striped
    thead
      tr
        th 名前
        th 在庫
        th 価格
        /!  th Del flg
        /!  th Company
        th colspan = "3"
  
    tbody
      - @products.each do |product|
        tr
          td = link_to product.name, product, class: ['btn', 'btn-default']
          td.v-middle = product.quantity
          td.v-middle = product.price
          /! td = product.company_id
          td = link_to '編集', edit_product_path(product), class: ['btn', 'btn-primary']
          td = link_to '削除', product, method: :delete, data: { confirm: 'Are you sure?' }, class: ['btn', 'btn-danger']
= paginate @products
