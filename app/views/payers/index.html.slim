p#notice = notice

h1 Payers

.table-responsive
  table.table.table-striped
    thead
      tr
        th 名前
        th 郵便番号
        th 住所
        th メールアドレス
        /!  th Del flg
        /!  th Company
        th colspan = "3"

    tbody
      - @payers.each do |payer|
        tr
          td.v-middle = full_name payer
          td.v-middle = payer.zip
          td.v-middle = address payer
          td.v-middle = payer.email
          /! td = product.company_id
          td = link_to 'Show', payer, class: ['btn', 'btn-default']
          td = link_to 'Edit', edit_payer_path(payer), class: ['btn', 'btn-primary']
          td = link_to 'Destroy', payer, method: :delete, data: { confirm: 'Are you sure?' }, class: ['btn', 'btn-danger']
= paginate @payers
