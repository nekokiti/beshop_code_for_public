<script>
(function ($) {
  //スムーススクロール
  $('a[href^="#"]').click(function () {
    var speed = 400;
    var href = $(this).attr('href');
    var target = $(href == '#' || href == '' ? 'html' : href);
    var position = target.offset().top;
    $('body,html').animate({
      scrollTop: position
    }, speed, 'swing');
    return false;
  });
  //toggle開閉
  $('.openable-button').addClass('closed');
  $('.openable-button').on('click', function () {
    $(this).toggleClass('closed');
    $(this).next().slideToggle(200);
  });
})(jQuery);
</script>
