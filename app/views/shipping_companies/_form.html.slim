= form_for(@shipping_company) do |f|
  - if @shipping_company.errors.any?
    #error_explanation
      h2 = "#{pluralize(@shipping_company.errors.count, "error")} prohibited this shipping_company from being saved:"

      ul
        - @shipping_company.errors.full_messages.each do |message|
          li = message

  .field.form-group
    = f.label :shipping_company_name
    = f.text_field :shipping_company_name, class: 'form-control'

  .actions
    - if controller.action_name == 'edit'
      button.btn.btn-primary type="submit" Edit
    - else
      button.btn.btn-primary type="submit" Create
    = link_to 'Back', shipping_companies_path, class: ['btn', 'btn-default', 'ml-1']
