h1
  span =t('activerecord.models.shipping_company')
  = link_to '新規配送業者登録', new_shipping_company_path, class: ['btn', 'btn-primary', 'ml-1']

.table-responsive
  table.table.table-striped
    thead
      tr
        th Name
        th colspan="2"

    tbody
      - @shipping_companies.each do |shipping_company|
        tr
          td = link_to shipping_company.shipping_company_name, shipping_company_path(shipping_company), class: ['btn', 'btn-default']
          td = link_to '編集', edit_shipping_company_path(shipping_company), class: ['btn', 'btn-primary']
          td = link_to '削除', shipping_company, method: :delete, data: { confirm: 'Are you sure?' }, class: ['btn', 'btn-danger']
= paginate @shipping_companies
